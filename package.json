{
  "name": "persian-mock-data",
  "version": "0.1.1",
  "description": "Deterministic, framework-agnostic Iranian mock data generators and validators.",
  "keywords": [
    "iran",
    "persian",
    "mock-data",
    "testing",
    "typescript"
  ],
  "license": "MIT",
  "author": "Ali Shahnoushi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ali-Shahnoushi/persian-mock-data.git"
  },
  "bugs": {
    "url": "https://github.com/Ali-Shahnoushi/persian-mock-data/issues"
  },
  "homepage": "https://github.com/Ali-Shahnoushi/persian-mock-data#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "check": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
